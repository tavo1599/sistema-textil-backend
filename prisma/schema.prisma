generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ==========================================
// 1. CATÁLOGOS Y E-COMMERCE
// ==========================================

model Almacen {
  id     Int            @id @default(autoincrement())
  nombre String
  tipo   String         // 'Principal', 'Remate', 'Web'
  stock  StockPrenda[]
}

model Color {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  codigo      String   @unique @default("XXX")
  codigoHex   String?
}

model Talla {
  id     Int    @id @default(autoincrement())
  nombre String // 'S', 'M', '30'
}

model Producto {
  id          Int     @id @default(autoincrement())
  skuBase     String  @unique // 'JEAN-SLIM-001'
  nombre      String
  categoria   String?

  imagenLocal    String?
  
  // PREPARACIÓN PARA E-COMMERCE (Página Web)
  publicadoWeb Boolean @default(false)
  descripcionWeb String?
  imagenUrl      String?
  precioWeb      Decimal @default(0.00) @db.Decimal(10, 2) // Precio público oficial para la tienda online

  boms        ProductoBom[]
  ordenes     OrdenProduccion[]
  stock       StockPrenda[]

  rutasBase      ProductoRuta[]
  inventarios InventarioTerminado[]
  detallesVenta VentaDetalle[]
  movimientos   MovimientoInventario[]
  detallesCompra  CompraDetalle[]
  costosPromedio  CostoPromedioProducto[]
  imagenes        ProductoImagen[]
}

// Pedido hecho desde la tienda online. Queda PENDIENTE hasta que el admin
// coordina el pago y lo procesa. NO descuenta stock automáticamente.
model PedidoWeb {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique
  clienteNombre String
  documento     String?
  telefono      String
  email         String?
  direccion     String?
  metodoEntrega String   @default("ENVIO")     // 'ENVIO' | 'RECOJO'
  metodoPago    String?                        // 'YAPE' | 'PLIN' | 'TRANSFERENCIA'
  voucherUrl    String?                        // foto del comprobante de pago
  notas         String?
  cuponCodigo   String?                        // código promocional aplicado
  descuento     Decimal  @default(0.00) @db.Decimal(10, 2) // monto descontado
  subtotal      Decimal  @default(0.00) @db.Decimal(10, 2) // total antes del descuento
  total         Decimal  @db.Decimal(10, 2)    // total final (subtotal - descuento)
  estado        String   @default("PENDIENTE") // PENDIENTE, CONFIRMADO, DESPACHADO, ENTREGADO, ANULADO
  fecha         DateTime @default(now())

  // Cuando se confirma, el pedido se convierte en una Venta real (descuenta stock).
  // Guardamos el id de la venta para no convertirlo dos veces.
  ventaId       Int?

  detalles      PedidoWebDetalle[]
}

model PedidoWebDetalle {
  id             Int       @id @default(autoincrement())
  pedidoId       Int
  pedido         PedidoWeb @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId     Int
  nombre         String
  color          String
  talla          String
  cantidad       Int
  precioUnitario Decimal   @db.Decimal(10, 2)
  subtotal       Decimal   @db.Decimal(10, 2)
}

// Códigos promocionales / cupones de descuento para la tienda online.
model CuponDescuento {
  id        Int       @id @default(autoincrement())
  codigo    String    @unique // se compara en MAYÚSCULAS, ej. BIENVENIDA10
  tipo      String    @default("PORCENTAJE") // 'PORCENTAJE' | 'MONTO'
  valor     Decimal   @db.Decimal(10, 2)     // 10 (=10%) o 20.00 (=S/20)
  minCompra Decimal   @default(0.00) @db.Decimal(10, 2) // compra mínima para aplicar
  maxUsos   Int?      // límite total de usos (null = ilimitado)
  usos      Int       @default(0)
  vence     DateTime? // fecha de vencimiento (null = sin vencimiento)
  activo    Boolean   @default(true)
}

// Libro de Reclamaciones virtual (Indecopi). Cada hoja es un reclamo o queja.
model Reclamacion {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique // Hoja de Reclamación, ej. HR-00001
  fecha           DateTime @default(now())

  // Identificación del consumidor
  nombre          String
  documento       String?
  telefono        String?
  email           String?
  direccion       String?
  menorEdad       Boolean  @default(false)

  // Identificación del bien contratado
  tipoBien        String?  // 'PRODUCTO' | 'SERVICIO'
  montoReclamado  String?
  descripcionBien String?
  pedidoCodigo    String?  // referencia opcional al pedido WEB-xxxxx

  // Detalle
  tipo            String   // 'RECLAMO' | 'QUEJA'
  detalle         String   // descripción del reclamo/queja
  pedidoConsumidor String? // pedido o solicitud del consumidor

  // Gestión interna
  estado          String   @default("PENDIENTE") // PENDIENTE, ATENDIDO
  respuesta       String?
}

// Reseñas de clientes para la tienda online (editables desde el admin).
model Resena {
  id        Int     @id @default(autoincrement())
  nombre    String
  texto     String
  estrellas Int     @default(5)
  orden     Int     @default(0)
  activo    Boolean @default(true)
}

// Banner promocional (imagen + texto + botón). Editable desde el admin.
model BannerPromo {
  id         Int     @id @default(autoincrement())
  url        String
  titulo     String?
  subtitulo  String?
  textoBoton String?
  enlace     String?
  orden      Int     @default(0)
  activo     Boolean @default(true)
}

// Configuración general de la tienda (una sola fila, id=1). WhatsApp, redes, contacto.
model ConfigTienda {
  id        Int     @id @default(1)
  whatsapp  String?
  instagram String?
  facebook  String?
  email     String?
  direccion String?
  horario   String?
  // Datos de pago que ve el cliente al comprar
  yape          String?  // número Yape
  plin          String?  // número Plin
  cuentaBanco   String?  // banco + número de cuenta / CCI
  titularCuenta String?  // nombre del titular
  // Marca y datos legales (para términos, privacidad, footer)
  logo          String?  // URL del logo de la tienda
  razonSocial   String?  // razón social de la empresa
  ruc           String?  // RUC
  // Imágenes de la sección "Nuestra historia" (2 fotos)
  historiaImg1  String?
  historiaImg2  String?
}

// Publicaciones tipo Instagram/reels para la tienda (foto o video propio).
// Administrable desde el admin (no depende de la API de Instagram).
model Publicacion {
  id        Int      @id @default(autoincrement())
  tipo      String   @default("imagen") // 'imagen' | 'video'
  url       String
  caption   String?
  enlace    String?  // enlace al post real de Instagram (opcional)
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  fecha     DateTime @default(now())
}

// Slides de la portada/carrusel de la tienda online (imágenes o videos).
model HeroSlide {
  id        Int      @id @default(autoincrement())
  tipo      String   @default("imagen") // 'imagen' | 'video'
  url       String
  titulo    String?
  subtitulo String?
  enlace    String?  // a dónde lleva el slide (ej. /tienda?categoria=Polos)
  orden     Int      @default(0)
  activo    Boolean  @default(true)
}

// Galería de imágenes de un producto para la tienda online.
// color = null  -> imagen general (portada / sin color específico)
// color = "AZUL" -> foto del producto en ese color (para el cambio de color)
model ProductoImagen {
  id         Int      @id @default(autoincrement())
  url        String
  color      String?
  orden      Int      @default(0)

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
}

model Insumo {
  id              Int     @id @default(autoincrement())
  codigo          String  @unique
  nombre          String
  tipo            String  // 'Tela', 'Avio', 'Empaque'
  unidadMedida    String
  costoUnitario   Decimal @default(0.0000)
  stockActual     Decimal @default(0.00)
  
  boms            ProductoBom[]
  detallesCompra  CompraDetalle[]
  movimientos     MovimientoInsumo[]
}

model ProveedorTaller {
  id          Int      @id @default(autoincrement())
  razonSocial String
  tipo        String   // 'Taller Confeccion', 'Lavanderia'
  telefono    String?

  rutas       OrdenRutaServicio[]
  guias       GuiaServicio[]
  memos       MemoIncidencia[]
}

// ==========================================
// 2. FICHA TÉCNICA (BOM)
// ==========================================

model ProductoBom {
  id               Int      @id @default(autoincrement())
  cantidadRequerida Decimal
  mermaEstimadaPct  Decimal  @default(0.00)

  productoId       Int
  producto         Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  
  insumoId         Int
  insumo           Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)
}

// ==========================================
// 3. PRODUCCIÓN Y COSTOS
// ==========================================

model OrdenProduccion {
  id               Int               @id @default(autoincrement())
  codigoOp         String            @unique
  fechaInicio      DateTime          @default(now())
  estado           String            @default("Pendiente")

  productoId       Int
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  detallesMatriz   OrdenDetalleMatriz[]
  rutas            OrdenRutaServicio[]
  guias            GuiaServicio[]
  memos            MemoIncidencia[]
  costeoFinal      OrdenCosteoFinal?
  
  // EL NUEVO ENCHUFE: Conecta la orden con sus gastos de Ploteo, Traslado, etc.
  gastosCif        OrdenGastoCif[]
}

model OrdenDetalleMatriz {
  id                  Int     @id @default(autoincrement())
  cantidadProgramada  Int
  cantidadEtiquetada1 Int     @default(0)
  cantidadEtiquetada2 Int     @default(0)

  ordenId             Int
  orden               OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  
  color               String @default("N/A")
  talla               String @default("N/A")
}

model OrdenRutaServicio {
  id                  Int     @id @default(autoincrement())
  tipoServicio        String  // 'Corte', 'Confeccion'
  ordenSecuencia      Int
  costoUnitarioPactado Decimal
  estado              String  @default("Pendiente")

  ordenId             Int
  orden               OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  
  tallerId            Int
  taller              ProveedorTaller @relation(fields: [tallerId], references: [id])
}

model ProductoRuta {
  id             Int      @id @default(autoincrement())
  tipoServicio   String   // 'Corte', 'Confeccion', 'Lavanderia', 'Ojal', etc.
  ordenSecuencia Int      // El orden cronológico (1, 2, 3...)

  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. LOGÍSTICA, CALIDAD Y STOCK FINAL
// ==========================================

model GuiaServicio {
  id          Int      @id @default(autoincrement())
  correlativo String   @unique
  tipoGuia    String   // 'Salida', 'Retorno'
  estado      String   @default("En Transito")

  ordenId     Int
  orden       OrdenProduccion @relation(fields: [ordenId], references: [id])
  
  tallerId    Int
  taller      ProveedorTaller @relation(fields: [tallerId], references: [id])

  detalles    GuiaDetalle[]
}

model GuiaDetalle {
  id               Int          @id @default(autoincrement())
  cantidadEnviada  Int          @default(0)
  cantidadRecibida Int          @default(0)
  cantidadFalla    Int          @default(0)

  guiaId           Int
  guia             GuiaServicio @relation(fields: [guiaId], references: [id], onDelete: Cascade)
  
  // Mismo idioma: Strings en lugar de IDs
  color            String @default("N/A")
  talla            String @default("N/A")
}

model MemoIncidencia {
  id                  Int      @id @default(autoincrement())
  correlativo         String   @unique
  tipoFalla           String
  cantidadAfectada    Int
  costoTotalPerdida   Decimal
  responsablePago     String
  estado              String   @default("Pendiente Descuento")

  ordenId             Int
  orden               OrdenProduccion @relation(fields: [ordenId], references: [id])
  
  tallerId            Int
  taller              ProveedorTaller @relation(fields: [tallerId], references: [id])
}

model StockPrenda {
  id         Int      @id @default(autoincrement())
  skuBarras  String   @unique // Lo que escaneas para vender
  cantidad   Int      @default(0)

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  
  // Cambiamos de Int a String y quitamos la relación forzada con la tabla
  color      String @default("N/A")  
  
  // Cambiamos de Int a String y quitamos la relación forzada con la tabla
  talla      String @default("N/A")
  
  almacenId  Int
  almacen    Almacen  @relation(fields: [almacenId], references: [id])
}

model OrdenCosteoFinal {
  id                   Int     @id @default(autoincrement())
  loteProducidoReal    Int
  costoTotalUnitarioNeto Decimal
  
  margenMayorista      Decimal @default(0.35)
  precioMayorista      Decimal
  margenMinorista      Decimal @default(0.70)
  precioMinorista      Decimal // ¡ESTE ES EL QUE LEERÁ TU PÁGINA WEB!

  ordenId              Int     @unique
  orden                OrdenProduccion @relation(fields: [ordenId], references: [id])
}

model Usuario {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  nombre   String
  rol      String  @default("USER") // "ADMIN" o "USER"
  logs     Auditoria[]
  ventas   Venta[] // ventas registradas por este usuario
}

model Auditoria {
  id          Int      @id @default(autoincrement())
  accion      String   // 'CREAR_ORDEN', 'REGISTRAR_VENTA', etc.
  tabla       String   // 'OrdenProduccion', 'Venta'
  registroId  Int
  detalles    String?  @db.Text
  fecha       DateTime @default(now())
  
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
}

// ==========================================
// 5. COSTOS INDIRECTOS DE FABRICACIÓN (CIF)
// ==========================================

model OrdenGastoCif {
  id          Int             @id @default(autoincrement())
  concepto    String          // Ej: 'Ploteo', 'Traslado', 'Patronista'
  costoTotal  Decimal         // El costo global sin IGV por todo el lote

  ordenId     Int
  orden       OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Bodega {
  id          Int      @id @default(autoincrement())
  nombre      String   // Ej: "Almacén Principal", "Tienda Lima", "Zona Fallados"
  tipo        String   // Ej: "Principal", "Sucursal", "Merma"
  direccion   String?
  estado      Boolean  @default(true)
  
  inventarios InventarioTerminado[]
  ventas        Venta[]
  movimientos   MovimientoInventario[]
}

model InventarioTerminado {
  id          Int      @id @default(autoincrement())
  productoId  Int
  bodegaId    Int
  color       String   
  talla       String   
  stock       Int      @default(0) 
  
  producto    Producto @relation(fields: [productoId], references: [id])
  bodega      Bodega   @relation(fields: [bodegaId], references: [id])

  // Esta regla evita que se creen dos filas iguales para el mismo pantalón en la misma tienda
  @@unique([productoId, bodegaId, color, talla]) 
}

// ==========================================
// 6. DESPACHOS Y VENTAS (LOGÍSTICA DE SALIDA)
// ==========================================

model DespachoVenta {
  id          Int      @id @default(autoincrement())
  codigoGuia  String   @unique  // Ej: 'GR-2026-001'
  cliente     String            // Nombre de la tienda o mayorista
  destino     String            // Dirección de entrega
  prendas     Int               // Cantidad total de ropa a enviar
  estado      String   @default("Listo para Empaque") // 'Listo para Empaque', 'En Tránsito'
  fecha       DateTime @default(now())
  ventaId     Int?     @unique
  venta       Venta?   @relation(fields: [ventaId], references: [id])
}

// ==========================================
// 7. VENTAS, HISTORIAL (POS) Y KARDEX
// ==========================================

model Venta {
  id              Int      @id @default(autoincrement())
  correlativo     String   @unique // Ej: 'BOL-00001'
  
  // Conexión con el cliente (Opcional por si es alguien de paso que paga al contado)
  clienteId       Int?
  cliente         Cliente? @relation(fields: [clienteId], references: [id])

  clienteNombre   String         @default("Público General")

  // Quién registró la venta (para el reporte: "quién lo vendió")
  usuarioId       Int?
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])

  tipoVenta       String   // 'MINORISTA', 'MAYORISTA'
  
  // 🔥 NUEVO: Lógica de Pagos
  condicionPago   String   @default("CONTADO") // 'CONTADO', 'CREDITO_ESTRICTO', 'CREDITO_FLEXIBLE'
  estadoPago      String   @default("PAGADO")  // 'PAGADO', 'PENDIENTE', 'PAGO_PARCIAL'
  
  metodoEntrega   String   
  destinoEnvio    String?  
  
  // Matemáticas de la venta
  totalVenta      Decimal        @default(0.00) @db.Decimal(10, 2)  // <-- Agrégale el @default(0.00)
  totalPagado     Decimal        @default(0.00) @db.Decimal(10, 2)
  
  estado          String   @default("Completada") 
  fecha           DateTime @default(now())

  bodegaId        Int
  bodega          Bodega   @relation(fields: [bodegaId], references: [id])

  detalles        VentaDetalle[]
  despacho        DespachoVenta? 
  
  // 🔥 Enlace a sus cuotas y recibos de pago
  cuotas          CuotaCredito[]
  abonos          Abono[]
}

model VentaDetalle {
  id              Int       @id @default(autoincrement())
  
  ventaId         Int
  venta           Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId      Int
  producto        Producto  @relation(fields: [productoId], references: [id])

  color           String
  talla           String
  cantidad        Int
  precioUnitario  Decimal   @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(10, 2) // cantidad * precioUnitario
}

model CuotaCredito {
  id               Int      @id @default(autoincrement())
  
  ventaId          Int
  venta            Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  
  numeroCuota      Int      // Ej: 1, 2, 3 (O 1 si es flexible)
  montoEsperado    Decimal  @db.Decimal(10, 2) // Cuánto debe pagar en esta cuota
  montoPagado      Decimal  @default(0.00) @db.Decimal(10, 2) // Cuánto ha ido abonando
  
  fechaVencimiento DateTime? // NULO = Flexible. CON FECHA = Estricto
  estado           String   @default("PENDIENTE") // 'PENDIENTE', 'PAGADA', 'VENCIDA'
  
  abonos           Abono[]  // Los pagos específicos a esta cuota
}

model Abono {
  id               Int      @id @default(autoincrement())
  
  ventaId          Int
  venta            Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  
  cuotaId          Int?
  cuota            CuotaCredito? @relation(fields: [cuotaId], references: [id])
  
  monto            Decimal  @db.Decimal(10, 2)
  metodoPago       String   // 'EFECTIVO', 'YAPE', 'PLIN', 'TRANSFERENCIA'
  referencia       String?  // Número de operación bancaria (Opcional)
  fecha            DateTime @default(now())
  anotacion        String?  // Ej: "Depositó su esposa", "Abono semanal"
}

model Cliente {
  id             Int      @id @default(autoincrement())
  documento      String?   @unique // DNI o RUC
  nombre         String
  telefono       String?
  direccion      String?
  
  // 🔥 CONTROL DE CRÉDITO
  limiteCredito  Decimal  @default(0.00) @db.Decimal(10, 2) // Ej: 5000.00
  saldoPendiente Decimal  @default(0.00) @db.Decimal(10, 2) // Deuda actual acumulada
  
  ventas         Venta[]  // Historial de todas sus compras
}

model MovimientoInventario {
  id              Int       @id @default(autoincrement())
  tipoMovimiento  String    
  motivo          String    
  cantidad        Int
  fecha           DateTime  @default(now())
  referenciaId    Int?      
  productoId      Int
  color           String
  talla           String
  bodegaId        Int

  // 🔥 KARDEX VALORIZADO (Costo Promedio Ponderado)
  // Estas columnas convierten el registro de movimientos en un kardex contable:
  // cada fila guarda no solo la cantidad, sino el valor del movimiento y el saldo.
  costoUnitario   Decimal?  @db.Decimal(12, 4)  // costo unitario de ESTE movimiento
  costoTotal      Decimal?  @db.Decimal(14, 4)  // costoUnitario * |cantidad|
  saldoCantidad   Int?                          // unidades en stock tras el movimiento
  saldoCostoProm  Decimal?  @db.Decimal(12, 4)  // costo promedio vigente tras el movimiento
  saldoValor      Decimal?  @db.Decimal(14, 4)  // saldoCantidad * saldoCostoProm

  producto        Producto  @relation(fields: [productoId], references: [id])
  bodega          Bodega    @relation(fields: [bodegaId], references: [id])
}

// ==========================================
// COSTO PROMEDIO PONDERADO POR VARIANTE
// ==========================================
// Guarda el costo promedio vigente de cada prenda (producto + color + talla).
// Se recalcula en cada INGRESO; las SALIDAS lo consumen sin recalcular.
// Costeo GLOBAL por variante (no por bodega): el costo de fabricar una prenda
// no cambia según en qué almacén esté guardada.
model CostoPromedioProducto {
  id            Int      @id @default(autoincrement())
  productoId    Int
  color         String   @default("N/A")
  talla         String   @default("N/A")
  costoPromedio Decimal  @default(0.0000) @db.Decimal(12, 4)
  stockValorado Int      @default(0)       // unidades sobre las que se calculó el promedio
  actualizadoEn DateTime @updatedAt

  producto      Producto @relation(fields: [productoId], references: [id])

  @@unique([productoId, color, talla])
}

// ==========================================
// 8. KARDEX DE INSUMOS (AVÍOS Y TELA)
// ==========================================
// Historial de movimientos de cada insumo.
// Se genera en cada compra (INGRESO) y en cada
// consumo por orden de producción (SALIDA).
// Permite saber cuánto se consumió por orden,
// cuándo y por qué, sin depender del campo
// stockActual como única fuente de verdad.
model MovimientoInsumo {
  id              Int      @id @default(autoincrement())
  tipoMovimiento  String   // 'INGRESO', 'SALIDA', 'AJUSTE', 'DEVOLUCION'
  motivo          String   // Ej: 'Compra FAC-001', 'OP-2026-001', 'Anulación OP'
  cantidad        Decimal  @db.Decimal(12, 4) // positivo=ingreso, negativo=salida
  fecha           DateTime @default(now())
  referenciaId    Int?     // ID de la Compra o de la OrdenProduccion

  insumoId        Int
  insumo          Insumo   @relation(fields: [insumoId], references: [id])

  // Saldo y costo al momento del movimiento (para auditoría completa)
  costoUnitario   Decimal  @db.Decimal(12, 4)
  costoTotal      Decimal  @db.Decimal(14, 4)
  saldoResultante Decimal  @db.Decimal(12, 4) // stockActual después del movimiento
}

model Proveedor {
  id            Int      @id @default(autoincrement())
  ruc           String?  @unique
  razonSocial   String
  telefono      String?
  direccion     String?
  tipo          String   @default("GENERAL") // 'INSUMOS', 'MERCADERIA', 'AMBOS'

  compras       Compra[]
}

model Compra {
  id            Int      @id @default(autoincrement())
  correlativo   String   @unique // Ej: 'FAC-001-456' (Factura del proveedor)
  fecha         DateTime @default(now())
  estado        String   @default("COMPLETADA") // 'COMPLETADA', 'PENDIENTE'
  totalCompra   Decimal  @default(0.00) @db.Decimal(10, 2)

  proveedorId   Int
  proveedor     Proveedor @relation(fields: [proveedorId], references: [id])

  detalles      CompraDetalle[]
}

model CompraDetalle {
  id            Int      @id @default(autoincrement())
  
  compraId      Int
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)

  // ¿Qué estamos comprando?
  tipoItem      String   // 'INSUMO' (Avíos) o 'PRENDA' (Mercadería terminada)

  // ----------------------------------------------------
  // OPCIÓN A: Si es un Insumo (Cierres, Hilos, Botones)
  insumoId      Int?
  insumo        Insumo?  @relation(fields: [insumoId], references: [id])

  // ----------------------------------------------------
  // OPCIÓN B: Si es Mercadería Terminada
  productoId    Int?
  producto      Producto? @relation(fields: [productoId], references: [id])
  color         String?
  
  talla         String?
  
  // 🔥 AQUÍ GUARDAMOS EL QR/CÓDIGO DE BARRAS DEL PROVEEDOR
  skuProveedor  String?  

  // ----------------------------------------------------
  // Datos financieros de la línea
  cantidad      Int
  costoUnitario Decimal  @db.Decimal(10, 4) // 4 decimales para mayor precisión en avíos
  subtotal      Decimal  @db.Decimal(10, 2)
}