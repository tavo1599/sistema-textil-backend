generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ==========================================
// 1. CATÁLOGOS Y E-COMMERCE
// ==========================================

model Almacen {
  id     Int            @id @default(autoincrement())
  nombre String
  tipo   String         // 'Principal', 'Remate', 'Web'
  stock  StockPrenda[]
}

model Color {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  codigo      String   @unique @default("XXX")
  codigoHex   String?
}

model Talla {
  id     Int    @id @default(autoincrement())
  nombre String // 'S', 'M', '30'
}

model Producto {
  id          Int     @id @default(autoincrement())
  skuBase     String  @unique // 'JEAN-SLIM-001'
  nombre      String
  categoria   String?

  imagenLocal    String?
  
  // PREPARACIÓN PARA E-COMMERCE (Página Web)
  publicadoWeb Boolean @default(false)
  descripcionWeb String?
  imagenUrl      String?

  boms        ProductoBom[]
  ordenes     OrdenProduccion[]
  stock       StockPrenda[]

  rutasBase      ProductoRuta[]
  inventarios InventarioTerminado[]
  detallesVenta VentaDetalle[]
  movimientos   MovimientoInventario[]
}

model Insumo {
  id              Int     @id @default(autoincrement())
  codigo          String  @unique
  nombre          String
  tipo            String  // 'Tela', 'Avio', 'Empaque'
  unidadMedida    String
  costoUnitario   Decimal @default(0.0000)
  stockActual     Decimal @default(0.00)
  
  boms            ProductoBom[]
}

model ProveedorTaller {
  id          Int      @id @default(autoincrement())
  razonSocial String
  tipo        String   // 'Taller Confeccion', 'Lavanderia'
  telefono    String?

  rutas       OrdenRutaServicio[]
  guias       GuiaServicio[]
  memos       MemoIncidencia[]
}

// ==========================================
// 2. FICHA TÉCNICA (BOM)
// ==========================================

model ProductoBom {
  id               Int      @id @default(autoincrement())
  cantidadRequerida Decimal
  mermaEstimadaPct  Decimal  @default(0.00)

  productoId       Int
  producto         Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  
  insumoId         Int
  insumo           Insumo   @relation(fields: [insumoId], references: [id], onDelete: Restrict)
}

// ==========================================
// 3. PRODUCCIÓN Y COSTOS
// ==========================================

model OrdenProduccion {
  id               Int               @id @default(autoincrement())
  codigoOp         String            @unique
  fechaInicio      DateTime          @default(now())
  estado           String            @default("Pendiente")

  productoId       Int
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  detallesMatriz   OrdenDetalleMatriz[]
  rutas            OrdenRutaServicio[]
  guias            GuiaServicio[]
  memos            MemoIncidencia[]
  costeoFinal      OrdenCosteoFinal?
  
  // EL NUEVO ENCHUFE: Conecta la orden con sus gastos de Ploteo, Traslado, etc.
  gastosCif        OrdenGastoCif[]
}

model OrdenDetalleMatriz {
  id                  Int     @id @default(autoincrement())
  cantidadProgramada  Int
  cantidadEtiquetada1 Int     @default(0)
  cantidadEtiquetada2 Int     @default(0)

  ordenId             Int
  orden               OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  
  color               String @default("N/A")
  talla               String @default("N/A")
}

model OrdenRutaServicio {
  id                  Int     @id @default(autoincrement())
  tipoServicio        String  // 'Corte', 'Confeccion'
  ordenSecuencia      Int
  costoUnitarioPactado Decimal
  estado              String  @default("Pendiente")

  ordenId             Int
  orden               OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  
  tallerId            Int
  taller              ProveedorTaller @relation(fields: [tallerId], references: [id])
}

model ProductoRuta {
  id             Int      @id @default(autoincrement())
  tipoServicio   String   // 'Corte', 'Confeccion', 'Lavanderia', 'Ojal', etc.
  ordenSecuencia Int      // El orden cronológico (1, 2, 3...)

  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. LOGÍSTICA, CALIDAD Y STOCK FINAL
// ==========================================

model GuiaServicio {
  id          Int      @id @default(autoincrement())
  correlativo String   @unique
  tipoGuia    String   // 'Salida', 'Retorno'
  estado      String   @default("En Transito")

  ordenId     Int
  orden       OrdenProduccion @relation(fields: [ordenId], references: [id])
  
  tallerId    Int
  taller      ProveedorTaller @relation(fields: [tallerId], references: [id])

  detalles    GuiaDetalle[]
}

model GuiaDetalle {
  id               Int          @id @default(autoincrement())
  cantidadEnviada  Int          @default(0)
  cantidadRecibida Int          @default(0)
  cantidadFalla    Int          @default(0)

  guiaId           Int
  guia             GuiaServicio @relation(fields: [guiaId], references: [id], onDelete: Cascade)
  
  // Mismo idioma: Strings en lugar de IDs
  color            String @default("N/A")
  talla            String @default("N/A")
}

model MemoIncidencia {
  id                  Int      @id @default(autoincrement())
  correlativo         String   @unique
  tipoFalla           String
  cantidadAfectada    Int
  costoTotalPerdida   Decimal
  responsablePago     String
  estado              String   @default("Pendiente Descuento")

  ordenId             Int
  orden               OrdenProduccion @relation(fields: [ordenId], references: [id])
  
  tallerId            Int
  taller              ProveedorTaller @relation(fields: [tallerId], references: [id])
}

model StockPrenda {
  id         Int      @id @default(autoincrement())
  skuBarras  String   @unique // Lo que escaneas para vender
  cantidad   Int      @default(0)

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  
  // Cambiamos de Int a String y quitamos la relación forzada con la tabla
  color      String @default("N/A")  
  
  // Cambiamos de Int a String y quitamos la relación forzada con la tabla
  talla      String @default("N/A")
  
  almacenId  Int
  almacen    Almacen  @relation(fields: [almacenId], references: [id])
}

model OrdenCosteoFinal {
  id                   Int     @id @default(autoincrement())
  loteProducidoReal    Int
  costoTotalUnitarioNeto Decimal
  
  margenMayorista      Decimal @default(0.35)
  precioMayorista      Decimal
  margenMinorista      Decimal @default(0.70)
  precioMinorista      Decimal // ¡ESTE ES EL QUE LEERÁ TU PÁGINA WEB!

  ordenId              Int     @unique
  orden                OrdenProduccion @relation(fields: [ordenId], references: [id])
}

model Usuario {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  nombre   String
  rol      String  @default("USER") // "ADMIN" o "USER"
  logs     Auditoria[]
}

model Auditoria {
  id          Int      @id @default(autoincrement())
  accion      String   // 'CREAR_ORDEN', 'REGISTRAR_VENTA', etc.
  tabla       String   // 'OrdenProduccion', 'Venta'
  registroId  Int
  detalles    String?  @db.Text
  fecha       DateTime @default(now())
  
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
}

// ==========================================
// 5. COSTOS INDIRECTOS DE FABRICACIÓN (CIF)
// ==========================================

model OrdenGastoCif {
  id          Int             @id @default(autoincrement())
  concepto    String          // Ej: 'Ploteo', 'Traslado', 'Patronista'
  costoTotal  Decimal         // El costo global sin IGV por todo el lote

  ordenId     Int
  orden       OrdenProduccion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Bodega {
  id          Int      @id @default(autoincrement())
  nombre      String   // Ej: "Almacén Principal", "Tienda Lima", "Zona Fallados"
  tipo        String   // Ej: "Principal", "Sucursal", "Merma"
  direccion   String?
  estado      Boolean  @default(true)
  
  inventarios InventarioTerminado[]
  ventas        Venta[]
  movimientos   MovimientoInventario[]
}

model InventarioTerminado {
  id          Int      @id @default(autoincrement())
  productoId  Int
  bodegaId    Int
  color       String   
  talla       String   
  stock       Int      @default(0) 
  
  producto    Producto @relation(fields: [productoId], references: [id])
  bodega      Bodega   @relation(fields: [bodegaId], references: [id])

  // Esta regla evita que se creen dos filas iguales para el mismo pantalón en la misma tienda
  @@unique([productoId, bodegaId, color, talla]) 
}

// ==========================================
// 6. DESPACHOS Y VENTAS (LOGÍSTICA DE SALIDA)
// ==========================================

model DespachoVenta {
  id          Int      @id @default(autoincrement())
  codigoGuia  String   @unique  // Ej: 'GR-2026-001'
  cliente     String            // Nombre de la tienda o mayorista
  destino     String            // Dirección de entrega
  prendas     Int               // Cantidad total de ropa a enviar
  estado      String   @default("Listo para Empaque") // 'Listo para Empaque', 'En Tránsito'
  fecha       DateTime @default(now())
  ventaId     Int?     @unique
  venta       Venta?   @relation(fields: [ventaId], references: [id])
}

// ==========================================
// 7. VENTAS, HISTORIAL (POS) Y KARDEX
// ==========================================

model Venta {
  id              Int      @id @default(autoincrement())
  correlativo     String   @unique // Ej: 'BOL-00001'
  
  // Conexión con el cliente (Opcional por si es alguien de paso que paga al contado)
  clienteId       Int?
  cliente         Cliente? @relation(fields: [clienteId], references: [id])

  clienteNombre   String         @default("Público General")

  tipoVenta       String   // 'MINORISTA', 'MAYORISTA'
  
  // 🔥 NUEVO: Lógica de Pagos
  condicionPago   String   @default("CONTADO") // 'CONTADO', 'CREDITO_ESTRICTO', 'CREDITO_FLEXIBLE'
  estadoPago      String   @default("PAGADO")  // 'PAGADO', 'PENDIENTE', 'PAGO_PARCIAL'
  
  metodoEntrega   String   
  destinoEnvio    String?  
  
  // Matemáticas de la venta
  totalVenta      Decimal        @default(0.00) @db.Decimal(10, 2)  // <-- Agrégale el @default(0.00)
  totalPagado     Decimal        @default(0.00) @db.Decimal(10, 2)
  
  estado          String   @default("Completada") 
  fecha           DateTime @default(now())

  bodegaId        Int
  bodega          Bodega   @relation(fields: [bodegaId], references: [id])

  detalles        VentaDetalle[]
  despacho        DespachoVenta? 
  
  // 🔥 Enlace a sus cuotas y recibos de pago
  cuotas          CuotaCredito[]
  abonos          Abono[]
}

model VentaDetalle {
  id              Int       @id @default(autoincrement())
  
  ventaId         Int
  venta           Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId      Int
  producto        Producto  @relation(fields: [productoId], references: [id])

  color           String
  talla           String
  cantidad        Int
  precioUnitario  Decimal   @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(10, 2) // cantidad * precioUnitario
}

model CuotaCredito {
  id               Int      @id @default(autoincrement())
  
  ventaId          Int
  venta            Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  
  numeroCuota      Int      // Ej: 1, 2, 3 (O 1 si es flexible)
  montoEsperado    Decimal  @db.Decimal(10, 2) // Cuánto debe pagar en esta cuota
  montoPagado      Decimal  @default(0.00) @db.Decimal(10, 2) // Cuánto ha ido abonando
  
  fechaVencimiento DateTime? // NULO = Flexible. CON FECHA = Estricto
  estado           String   @default("PENDIENTE") // 'PENDIENTE', 'PAGADA', 'VENCIDA'
  
  abonos           Abono[]  // Los pagos específicos a esta cuota
}

model Abono {
  id               Int      @id @default(autoincrement())
  
  ventaId          Int
  venta            Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  
  cuotaId          Int?
  cuota            CuotaCredito? @relation(fields: [cuotaId], references: [id])
  
  monto            Decimal  @db.Decimal(10, 2)
  metodoPago       String   // 'EFECTIVO', 'YAPE', 'PLIN', 'TRANSFERENCIA'
  referencia       String?  // Número de operación bancaria (Opcional)
  fecha            DateTime @default(now())
  anotacion        String?  // Ej: "Depositó su esposa", "Abono semanal"
}

model Cliente {
  id             Int      @id @default(autoincrement())
  documento      String?   @unique // DNI o RUC
  nombre         String
  telefono       String?
  direccion      String?
  
  // 🔥 CONTROL DE CRÉDITO
  limiteCredito  Decimal  @default(0.00) @db.Decimal(10, 2) // Ej: 5000.00
  saldoPendiente Decimal  @default(0.00) @db.Decimal(10, 2) // Deuda actual acumulada
  
  ventas         Venta[]  // Historial de todas sus compras
}

model MovimientoInventario {
  id              Int       @id @default(autoincrement())
  tipoMovimiento  String    
  motivo          String    
  cantidad        Int
  fecha           DateTime  @default(now())
  referenciaId    Int?      
  productoId      Int
  color           String
  talla           String
  bodegaId        Int
  
  producto        Producto  @relation(fields: [productoId], references: [id])
  bodega          Bodega    @relation(fields: [bodegaId], references: [id])
}